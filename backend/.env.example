# Copy to backend/.env and fill in.

# Google AI Studio key (https://aistudio.google.com/apikey). Without it the API still runs:
# search uses an offline hashing embedder and AI endpoints return a "disabled" message.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Use a long random value outside local development: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-0000

# SQLite by default; any SQLAlchemy URL works (e.g. postgresql+psycopg://user:pass@host/db).
# DATABASE_URL=sqlite:///./data/silversync.db

# Password given to the demo users (admin@, doctor@, nurse@, accountant@, hr@, receptionist@silversync.com)
SEED_PASSWORD=silversync-dev

CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
